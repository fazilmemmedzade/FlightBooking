    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        (function () {
            'use strict';

            const ROUTES = [
                {
                    fromCity: 'İstanbul',
                    toCity: 'Amsterdam',
                    dur: '3 saat 35 dəq',
                    price: '4.799',
                    img: 'https://images.unsplash.com/photo-1534351590666-13e3e96b5017?auto=format&fit=crop&w=800&q=80'
                },
                {
                    fromCity: 'İstanbul',
                    toCity: 'Milan',
                    dur: '3 saat 05 dəq',
                    price: '4.299',
                    img: 'https://images.unsplash.com/photo-1520440229-6469a149ac59?auto=format&fit=crop&w=800&q=80'
                },
                {
                    fromCity: 'İstanbul',
                    toCity: 'Paris',
                    dur: '3 saat 55 dəq',
                    price: '5.150',
                    img: 'https://images.unsplash.com/photo-1502602898657-3e91760cbb34?auto=format&fit=crop&w=800&q=80'
                },
                {
                    fromCity: 'İstanbul',
                    toCity: 'Roma',
                    dur: '2 saat 55 dəq',
                    price: '3.999',
                    img: 'https://images.unsplash.com/photo-1552832230-c0197dd311b5?auto=format&fit=crop&w=800&q=80'
                },
                {
                    fromCity: 'İstanbul',
                    toCity: 'Berlin',
                    dur: '3 saat 10 dəq',
                    price: '4.450',
                    img: 'https://images.unsplash.com/photo-1560969184-10fe8719e047?auto=format&fit=crop&w=800&q=80'
                },
                {
                    fromCity: 'İstanbul',
                    toCity: 'London',
                    dur: '4 saat 05 dəq',
                    price: '5.650',
                    img: 'https://images.unsplash.com/photo-1513635269975-59663e0ac1ad?auto=format&fit=crop&w=800&q=80'
                }
            ];

            const $ = (selector, context = document) =>
                context.querySelector(selector);

            const $$ = (selector, context = document) =>
                Array.from(context.querySelectorAll(selector));

            const navbar = $('#mainNavbar');

            function handleNavbarScroll() {
                if (window.scrollY > 40) {
                    navbar.classList.add('sr-scrolled');
                } else {
                    navbar.classList.remove('sr-scrolled');
                }
            }

            window.addEventListener(
                'scroll',
                handleNavbarScroll,
                { passive: true }
            );

            handleNavbarScroll();

            const fromInput = $('#fromInput');
            const toInput = $('#toInput');
            const swapBtn = $('#swapBtn');

            swapBtn.addEventListener('click', () => {
                const temporary = fromInput.value;

                fromInput.value = toInput.value;
                toInput.value = temporary;

                swapBtn.classList.toggle('sr-rotate');

                clearError(fromInput);
                clearError(toInput);
            });

            const returnWrap = $('#returnWrap');
            const returnDate = $('#returnDate');

            function updateTripType() {
                const selectedType =
                    $('input[name="tripType"]:checked').value;

                if (selectedType === 'oneway') {
                    returnWrap.style.display = 'none';
                    returnDate.value = '';
                } else {
                    returnWrap.style.display = '';
                }
            }

            $$('input[name="tripType"]').forEach(input => {
                input.addEventListener(
                    'change',
                    updateTripType
                );
            });

            updateTripType();

            const departDate = $('#departDate');

            const today =
                new Date()
                    .toISOString()
                    .split('T')[0];

            departDate.min = today;
            returnDate.min = today;

            departDate.addEventListener('change', () => {
                returnDate.min =
                    departDate.value || today;

                if (
                    returnDate.value &&
                    returnDate.value < departDate.value
                ) {
                    returnDate.value =
                        departDate.value;
                }

                clearError(departDate);
            });

            const counts = {
                adult: 1,
                child: 0,
                infant: 0
            };

            const MAX_TOTAL = 9;

            const passengerElements = {
                adult: $('#adultCount'),
                child: $('#childCount'),
                infant: $('#infantCount')
            };

            const paxNote = $('#paxNote');

            function totalPassengers() {
                return (
                    counts.adult +
                    counts.child +
                    counts.infant
                );
            }

            function updatePassengerUI() {

                passengerElements.adult.textContent =
                    counts.adult;

                passengerElements.child.textContent =
                    counts.child;

                passengerElements.infant.textContent =
                    counts.infant;

                $('#passengerSummary').textContent =
                    `${totalPassengers()} sərnişin`;

                $$('.sr-step-btn').forEach(button => {

                    const type =
                        button.dataset.type;

                    const action =
                        button.dataset.action;

                    let disabled = false;

                    if (action === 'dec') {

                        if (type === 'adult') {
                            disabled =
                                counts.adult <= 1;
                        } else {
                            disabled =
                                counts[type] <= 0;
                        }

                    } else {

                        if (
                            totalPassengers() >=
                            MAX_TOTAL
                        ) {
                            disabled = true;
                        }

                        if (
                            type === 'infant' &&
                            counts.infant >=
                            counts.adult
                        ) {
                            disabled = true;
                        }
                    }

                    button.disabled = disabled;
                });

                if (
                    counts.infant >= counts.adult &&
                    counts.infant > 0
                ) {
                    paxNote.textContent =
                        'Körpələrin sayı böyüklərin sayından çox ola bilməz.';
                } else if (
                    totalPassengers() >= MAX_TOTAL
                ) {
                    paxNote.textContent =
                        'Ən çox 9 sərnişin seçə bilərsiniz.';
                } else {
                    paxNote.textContent = '';
                }
            }

            $$('.sr-step-btn').forEach(button => {

                button.addEventListener('click', () => {

                    const type =
                        button.dataset.type;

                    const action =
                        button.dataset.action;

                    if (action === 'inc') {

                        if (
                            totalPassengers() >=
                            MAX_TOTAL
                        ) {
                            return;
                        }

                        if (
                            type === 'infant' &&
                            counts.infant >=
                            counts.adult
                        ) {
                            return;
                        }

                        counts[type]++;

                    } else {

                        if (
                            type === 'adult' &&
                            counts.adult <= 1
                        ) {
                            return;
                        }

                        if (counts[type] <= 0) {
                            return;
                        }

                        counts[type]--;

                        if (
                            type === 'adult' &&
                            counts.infant >
                            counts.adult
                        ) {
                            counts.infant =
                                counts.adult;
                        }
                    }

                    updatePassengerUI();
                });
            });

            updatePassengerUI();

            const cabinClass = $('#cabinClass');

            const cabinLabels = {
                economy: 'Ekonom',
                premium: 'Premium ekonom',
                business: 'Biznes',
                first: 'Birinci sinif'
            };

            cabinClass.addEventListener('change', () => {

                $('#cabinSummary').textContent =
                    cabinLabels[cabinClass.value];
            });

            $('#paxDone').addEventListener('click', () => {

                const toggle =
                    $('#passengerToggle');

                const dropdown =
                    bootstrap.Dropdown.getInstance(toggle) ||
                    new bootstrap.Dropdown(toggle);

                dropdown.hide();
            });

            const routesRow =
                $('.sr-routes-row');

            routesRow.innerHTML = '';

            ROUTES.forEach(route => {

                const column =
                    document.createElement('div');

                column.className =
                    'col-12 col-sm-6 col-lg-4';

                column.innerHTML = `
                    <div class="sr-route-card">

                        <div class="sr-route-media"
                             style="background-image:url('${route.img}')">

                            <span class="sr-route-duration">
                                <i class="bi bi-clock"></i>
                                ${route.dur}
                            </span>

                        </div>

                        <div class="sr-route-body">

                            <div class="sr-route-path">

                                <div class="sr-route-point">
                                    <div class="sr-route-city">
                                        ${route.fromCity}
                                    </div>
                                </div>

                                <i class="bi bi-airplane sr-route-arrow"></i>

                                <div class="sr-route-point">
                                    <div class="sr-route-city">
                                        ${route.toCity}
                                    </div>
                                </div>

                            </div>

                            <div class="sr-route-price">
                                ${route.price} ₺-dən başlayan qiymətlərlə
                            </div>

                            <button type="button"
                                    class="btn btn-sr-outline sr-route-btn">

                                <i class="bi bi-search me-1"></i>
                                Uçuşlara bax

                            </button>

                        </div>
                    </div>
                `;

                routesRow.appendChild(column);

                column
                    .querySelector('.sr-route-btn')
                    .addEventListener('click', () => {

                        fromInput.value =
                            route.fromCity;

                        toInput.value =
                            route.toCity;

                        clearError(fromInput);
                        clearError(toInput);

                        $('#aramaPaneli')
                            .scrollIntoView({
                                behavior: 'smooth',
                                block: 'center'
                            });

                        showToast(
                            `${route.fromCity} → ${route.toCity} marşrutu forma əlavə edildi.`,
                            'success'
                        );
                    });
            });

            function setError(input, message) {

                input.classList.add('is-invalid');

                const wrapper =
                    input.closest('.sr-field-wrap');

                if (!wrapper) {
                    return;
                }

                const errorElement =
                    wrapper.querySelector('.sr-error');

                if (errorElement) {
                    errorElement.textContent =
                        message;
                }
            }

            function clearError(input) {

                input.classList.remove('is-invalid');

                const wrapper =
                    input.closest('.sr-field-wrap');

                if (!wrapper) {
                    return;
                }

                const errorElement =
                    wrapper.querySelector('.sr-error');

                if (errorElement) {
                    errorElement.textContent = '';
                }
            }

            function cleanCity(value) {
                return (value || '')
                    .trim()
                    .replace(/\s+/g, ' ');
            }

            [fromInput, toInput].forEach(input => {

                input.addEventListener('input', () => {
                    clearError(input);
                });
            });

            const form =
                $('#flightSearchForm');

            const searchBtn =
                $('#searchBtn');

            form.addEventListener(
                'submit',
                function (event) {

                    event.preventDefault();

                    let valid = true;

                    const tripType =
                        $('input[name="tripType"]:checked')
                            .value;

                    const fromCity =
                        cleanCity(fromInput.value);

                    const toCity =
                        cleanCity(toInput.value);

                    if (!fromCity) {

                        setError(
                            fromInput,
                            'Gediş şəhərini yazın.'
                        );

                        valid = false;

                    } else {
                        clearError(fromInput);
                    }

                    if (!toCity) {

                        setError(
                            toInput,
                            'Təyinat şəhərini yazın.'
                        );

                        valid = false;

                    } else {
                        clearError(toInput);
                    }

                    if (
                        fromCity &&
                        toCity &&
                        fromCity.toLocaleLowerCase('az') ===
                        toCity.toLocaleLowerCase('az')
                    ) {

                        setError(
                            toInput,
                            'Gediş və təyinat eyni ola bilməz.'
                        );

                        valid = false;
                    }

                    if (!departDate.value) {

                        setError(
                            departDate,
                            'Gediş tarixini seçin.'
                        );

                        valid = false;

                    } else {
                        clearError(departDate);
                    }

                    if (tripType === 'round') {

                        if (!returnDate.value) {

                            setError(
                                returnDate,
                                'Dönüş tarixini seçin.'
                            );

                            valid = false;

                        } else if (
                            departDate.value &&
                            returnDate.value <
                            departDate.value
                        ) {

                            setError(
                                returnDate,
                                'Dönüş tarixi gediş tarixindən əvvəl ola bilməz.'
                            );

                            valid = false;

                        } else {
                            clearError(returnDate);
                        }
                    }

                    if (!valid) {

                        showToast(
                            'Zəhmət olmasa, çatışmayan sahələri yoxlayın.',
                            'error'
                        );

                        return;
                    }

                    const searchParams =
                        new URLSearchParams({
                            fromCity: fromCity,
                            toCity: toCity,
                            depart: departDate.value,
                            return: returnDate.value || '',
                            adults: counts.adult,
                            children: counts.child,
                            infants: counts.infant,
                            cabin: cabinClass.value,
                            tripType: tripType
                        });

                    searchBtn.disabled = true;

                    $('.sr-btn-label', searchBtn)
                        .classList.add('d-none');

                    $('.sr-btn-loading', searchBtn)
                        .classList.remove('d-none');

                    window.location.href =
                        '/Flight/Search?' +
                        searchParams.toString();
                }
            );

            const newsletterForm =
                $('#newsletterForm');

            const newsletterEmail =
                $('#newsletterEmail');

            const newsletterError =
                $('#newsletterError');

            const EMAIL_RE =
                /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;

            newsletterForm.addEventListener(
                'submit',
                function (event) {

                    event.preventDefault();

                    const value =
                        newsletterEmail.value.trim();

                    if (!value) {

                        newsletterError.textContent =
                            'E-poçt ünvanı tələb olunur.';

                        newsletterEmail
                            .classList
                            .add('is-invalid');

                    } else if (!EMAIL_RE.test(value)) {

                        newsletterError.textContent =
                            'Düzgün e-poçt ünvanı daxil edin.';

                        newsletterEmail
                            .classList
                            .add('is-invalid');

                    } else {

                        newsletterError.textContent = '';

                        newsletterEmail
                            .classList
                            .remove('is-invalid');

                        newsletterEmail.value = '';

                        showToast(
                            'Abunəliyiniz uğurla yaradıldı.',
                            'success'
                        );
                    }
                }
            );

            newsletterEmail.addEventListener(
                'input',
                () => {

                    newsletterEmail
                        .classList
                        .remove('is-invalid');

                    newsletterError.textContent = '';
                }
            );

            function showToast(message, type) {

                const toastElement =
                    $('#srToast');

                $('#srToastBody')
                    .textContent = message;

                toastElement.classList.remove(
                    'sr-toast-success',
                    'sr-toast-error'
                );

                if (type === 'success') {
                    toastElement.classList.add(
                        'sr-toast-success'
                    );
                }

                if (type === 'error') {
                    toastElement.classList.add(
                        'sr-toast-error'
                    );
                }

                const toast =
                    bootstrap.Toast.getInstance(
                        toastElement
                    ) ||
                    new bootstrap.Toast(
                        toastElement,
                        {
                            delay: 3500
                        }
                    );

                toast.show();
            }

        })();
    </script>
</body>
</html>