@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="az">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="SkyRoute ilə yüzlərlə aviaşirkətin uçuşlarını müqayisə et, sənin üçün ən uyğun səyahəti asanlıqla tap.">
    <title>SkyRoute — Uçuş axtar, müqayisə et, uç</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Sora:wght@600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --sr-navy: #0f2f52;
            --sr-blue: #1668c9;
            --sr-blue-dark: #114f9c;
            --sr-sky: #4aa3e8;
            --sr-sky-soft: #e8f2fc;
            --sr-teal: #17b3a3;
            --sr-amber: #f5a623;
            --sr-ink: #24313f;
            --sr-muted: #6b7a8c;
            --sr-line: #e2e8f0;
            --sr-bg: #ffffff;
            --sr-bg-alt: #f4f7fb;
            --sr-radius: 10px;
            --sr-radius-sm: 8px;
            --sr-shadow: 0 10px 30px rgba(15, 47, 82, .10);
            --sr-shadow-sm: 0 4px 14px rgba(15, 47, 82, .08);
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            color: var(--sr-ink);
            background: var(--sr-bg);
            -webkit-font-smoothing: antialiased;
            overflow-x: hidden;
        }

        h1,
        h2,
        h3,
        .sr-logo-text {
            font-family: 'Sora', 'Inter', sans-serif;
        }

        a {
            text-decoration: none;
        }

            a:focus-visible,
            button:focus-visible,
            input:focus-visible,
            select:focus-visible,
            .btn:focus-visible {
                outline: 3px solid rgba(22, 104, 201, .45);
                outline-offset: 2px;
            }

        .sr-navbar {
            background: transparent;
            padding: .9rem 0;
            transition: background-color .3s ease, box-shadow .3s ease, padding .3s ease;
        }

            .sr-navbar.sr-scrolled {
                background: #ffffff;
                box-shadow: 0 4px 20px rgba(15, 47, 82, .10);
                padding: .55rem 0;
            }

        .sr-logo-mark {
            width: 38px;
            height: 38px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, var(--sr-blue), var(--sr-sky));
            color: #fff;
            border-radius: var(--sr-radius-sm);
            font-size: 1.05rem;
            transform: rotate(-8deg);
        }

        .sr-logo-text {
            font-weight: 800;
            font-size: 1.35rem;
            color: #fff;
            letter-spacing: -.5px;
        }

        .sr-logo-accent {
            color: var(--sr-sky);
        }

        .sr-navbar.sr-scrolled .sr-logo-text {
            color: var(--sr-navy);
        }

        .sr-navbar.sr-scrolled .nav-link {
            color: var(--sr-ink);
        }

        .sr-navbar.sr-scrolled .navbar-toggler {
            color: var(--sr-navy);
        }

        .sr-navbar .nav-link {
            color: rgba(255, 255, 255, .92);
            font-weight: 500;
            font-size: .95rem;
            padding: .5rem .9rem;
            border-radius: 6px;
            transition: color .2s, background-color .2s;
        }

            .sr-navbar .nav-link:hover,
            .sr-navbar .nav-link.active {
                color: var(--sr-sky);
            }

        .sr-navbar.sr-scrolled .nav-link:hover,
        .sr-navbar.sr-scrolled .nav-link.active {
            color: var(--sr-blue);
        }

        .navbar-toggler {
            border: none;
            color: #fff;
            font-size: 1.6rem;
            padding: 0 .25rem;
        }

            .navbar-toggler:focus {
                box-shadow: none;
            }

        .sr-mini-select {
            width: auto;
            min-width: 74px;
            border-radius: 6px;
            font-weight: 500;
            border-color: rgba(255, 255, 255, .35);
            background-color: rgba(255, 255, 255, .12);
            color: #fff;
        }

            .sr-mini-select option {
                color: #24313f;
            }

        .sr-navbar.sr-scrolled .sr-mini-select {
            border-color: var(--sr-line);
            background-color: #fff;
            color: var(--sr-ink);
        }

        .btn-sr-login {
            background: var(--sr-teal);
            color: #fff;
            font-weight: 600;
            border-radius: 6px;
            padding: .45rem 1.1rem;
            white-space: nowrap;
            transition: background-color .2s, transform .15s;
        }

            .btn-sr-login:hover {
                background: #12a08f;
                color: #fff;
                transform: translateY(-1px);
            }

        .sr-hero {
            position: relative;
        }

        #heroSlider,
        .carousel-inner {
            height: 560px;
        }

        .sr-slide {
            position: relative;
            height: 100%;
            background-size: cover;
            background-position: center;
            display: flex;
            align-items: center;
        }

        .sr-slide-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient( 100deg, rgba(11, 34, 60, .78) 0%, rgba(11, 34, 60, .45) 45%, rgba(11, 34, 60, .15) 100% );
        }

        .sr-slide-content {
            position: relative;
            z-index: 2;
            color: #fff;
            max-width: 620px;
            padding-bottom: 3rem;
        }

        .sr-eyebrow {
            display: inline-block;
            text-transform: uppercase;
            letter-spacing: 2px;
            font-size: .78rem;
            font-weight: 600;
            color: var(--sr-sky);
            margin-bottom: .75rem;
        }

        .sr-slide-title {
            font-size: 2.9rem;
            font-weight: 800;
            line-height: 1.12;
            margin-bottom: 1rem;
            letter-spacing: -.5px;
        }

        .sr-slide-desc {
            font-size: 1.15rem;
            color: rgba(255, 255, 255, .9);
            max-width: 540px;
        }

        .sr-control {
            width: 5%;
            opacity: 1;
        }

        .sr-control-icon {
            width: 46px;
            height: 46px;
            border-radius: 50%;
            background: rgba(255, 255, 255, .18);
            backdrop-filter: blur(4px);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 1.3rem;
            transition: background-color .2s;
        }

        .sr-control:hover .sr-control-icon {
            background: rgba(255, 255, 255, .35);
        }

        .sr-indicators {
            margin-bottom: 1.5rem;
        }

            .sr-indicators [data-bs-target] {
                width: 10px;
                height: 10px;
                border-radius: 50%;
                border: none;
                background: rgba(255, 255, 255, .55);
                opacity: 1;
                transition: width .3s, background-color .3s;
            }

            .sr-indicators .active {
                width: 26px;
                border-radius: 6px;
                background: #fff;
            }

        .sr-search-panel {
            position: relative;
            margin-top: -90px;
            margin-bottom: 1rem;
            background: #fff;
            border-radius: var(--sr-radius);
            box-shadow: var(--sr-shadow);
            padding: 1.5rem;
            z-index: 5;
            border: 1px solid var(--sr-line);
        }

        .sr-trip-types {
            display: inline-flex;
            gap: .4rem;
            margin-bottom: 1.25rem;
            flex-wrap: wrap;
        }

        .sr-trip-btn {
            cursor: pointer;
            padding: .5rem 1rem;
            border-radius: 8px;
            font-weight: 600;
            font-size: .9rem;
            color: var(--sr-muted);
            background: var(--sr-bg-alt);
            border: 1px solid transparent;
            transition: all .18s;
            margin: 0;
        }

        .btn-check:checked + .sr-trip-btn {
            color: var(--sr-blue);
            background: var(--sr-sky-soft);
            border-color: rgba(22, 104, 201, .4);
        }

        .sr-trip-btn:hover {
            color: var(--sr-blue);
        }

        .sr-field-wrap {
            position: relative;
        }

        .sr-label {
            display: block;
            font-size: .78rem;
            font-weight: 600;
            color: var(--sr-muted);
            margin-bottom: .35rem;
            text-transform: uppercase;
            letter-spacing: .4px;
        }

        .sr-input-icon {
            position: relative;
        }

            .sr-input-icon > i {
                position: absolute;
                left: .85rem;
                top: 50%;
                transform: translateY(-50%);
                color: var(--sr-sky);
                font-size: 1.05rem;
                pointer-events: none;
                z-index: 2;
            }

        .sr-input {
            height: 52px;
            border-radius: var(--sr-radius-sm);
            border: 1px solid var(--sr-line);
            background: #fff;
            font-size: .95rem;
            font-weight: 500;
            color: var(--sr-ink);
            padding-left: 2.6rem;
            transition: border-color .2s, box-shadow .2s;
        }

            .sr-input:focus {
                border-color: var(--sr-blue);
                box-shadow: 0 0 0 3px rgba(22, 104, 201, .12);
            }

            .sr-input::placeholder {
                color: #9aa7b6;
                font-weight: 400;
            }

        .sr-swap-row {
            --swap-size: 40px;
        }

        .sr-swap-btn {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -20%);
            width: var(--swap-size);
            height: var(--swap-size);
            border-radius: 50%;
            border: 2px solid var(--sr-line);
            background: #fff;
            color: var(--sr-blue);
            font-size: 1rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            z-index: 4;
            box-shadow: var(--sr-shadow-sm);
            transition: transform .3s, background-color .2s, color .2s;
        }

            .sr-swap-btn:hover {
                background: var(--sr-blue);
                color: #fff;
            }

            .sr-swap-btn.sr-rotate {
                transform: translate(-50%, -20%) rotate(180deg);
            }

        .sr-passenger-menu {
            min-width: 300px;
            border: 1px solid var(--sr-line);
            box-shadow: var(--sr-shadow);
            border-radius: var(--sr-radius);
        }

        .sr-dropdown-toggle {
            display: flex;
            align-items: center;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

            .sr-dropdown-toggle::after {
                display: none;
            }

        .sr-pax-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: .55rem 0;
        }

        .sr-pax-title {
            font-weight: 600;
            color: var(--sr-navy);
            font-size: .95rem;
        }

        .sr-pax-sub {
            font-size: .78rem;
            color: var(--sr-muted);
        }

        .sr-pax-note {
            font-size: .78rem;
            color: var(--sr-amber);
            font-weight: 500;
            min-height: 1rem;
        }

        .sr-stepper {
            display: inline-flex;
            align-items: center;
            gap: .6rem;
        }

        .sr-step-btn {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            border: 1.5px solid var(--sr-line);
            background: #fff;
            color: var(--sr-blue);
            font-size: 1.15rem;
            font-weight: 600;
            line-height: 1;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: all .15s;
        }

            .sr-step-btn:hover:not(:disabled) {
                border-color: var(--sr-blue);
                background: var(--sr-sky-soft);
            }

            .sr-step-btn:disabled {
                opacity: .4;
                cursor: not-allowed;
            }

        .sr-step-value {
            min-width: 20px;
            text-align: center;
            font-weight: 700;
            color: var(--sr-navy);
        }

        .sr-error {
            color: #d33a3a;
            font-size: .78rem;
            margin-top: .3rem;
            min-height: 1rem;
            font-weight: 500;
        }

        .sr-input.is-invalid {
            border-color: #d33a3a;
        }

        .btn-sr-primary {
            background: var(--sr-blue);
            color: #fff;
            font-weight: 600;
            border-radius: var(--sr-radius-sm);
            padding: .7rem 1.4rem;
            border: none;
            transition: background-color .2s, transform .15s;
        }

            .btn-sr-primary:hover {
                background: var(--sr-blue-dark);
                color: #fff;
                transform: translateY(-1px);
            }

        .btn-sr-search {
            height: 52px;
            background: var(--sr-blue);
            color: #fff;
            font-weight: 700;
            font-size: 1.02rem;
            border: none;
            border-radius: var(--sr-radius-sm);
            transition: background-color .2s, transform .15s;
        }

            .btn-sr-search:hover {
                background: var(--sr-blue-dark);
                color: #fff;
                transform: translateY(-1px);
            }

            .btn-sr-search:disabled {
                opacity: .85;
            }

        .sr-section {
            padding: 4.5rem 0;
        }

        .sr-section-alt {
            background: var(--sr-bg-alt);
        }

        .sr-section-head {
            text-align: center;
            max-width: 640px;
            margin: 0 auto 2.5rem;
        }

        .sr-section-eyebrow {
            text-transform: uppercase;
            letter-spacing: 2px;
            font-size: .78rem;
            font-weight: 700;
            color: var(--sr-blue);
            margin-bottom: .5rem;
        }

        .sr-eyebrow-light {
            color: var(--sr-sky);
        }

        .sr-section-title {
            font-size: 2rem;
            font-weight: 800;
            color: var(--sr-navy);
            letter-spacing: -.5px;
        }

        .sr-section-sub {
            color: var(--sr-muted);
            font-size: 1.05rem;
            margin-top: .5rem;
        }

        .sr-route-card {
            background: #fff;
            border: 1px solid var(--sr-line);
            border-radius: var(--sr-radius);
            overflow: hidden;
            height: 100%;
            box-shadow: var(--sr-shadow-sm);
            transition: transform .2s ease, box-shadow .2s ease;
        }

            .sr-route-card:hover {
                transform: translateY(-5px);
                box-shadow: var(--sr-shadow);
            }

        .sr-route-media {
            height: 160px;
            background-size: cover;
            background-position: center;
            position: relative;
        }

            .sr-route-media::after {
                content: '';
                position: absolute;
                inset: 0;
                background: linear-gradient( 180deg, rgba(15,47,82,0) 40%, rgba(15,47,82,.55) 100% );
            }

        .sr-route-duration {
            position: absolute;
            bottom: .7rem;
            left: .8rem;
            z-index: 2;
            color: #fff;
            font-size: .82rem;
            font-weight: 500;
        }

            .sr-route-duration i {
                margin-right: .3rem;
            }

        .sr-route-body {
            padding: 1.1rem 1.15rem 1.25rem;
        }

        .sr-route-path {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: .35rem;
        }

        .sr-route-point {
            text-align: center;
        }

        .sr-route-city {
            font-weight: 700;
            color: var(--sr-navy);
            font-size: 1rem;
            line-height: 1.1;
        }

        .sr-route-arrow {
            color: var(--sr-sky);
            font-size: 1.2rem;
        }

        .sr-route-price {
            font-size: .85rem;
            color: var(--sr-muted);
            margin: .5rem 0 .9rem;
        }

        .btn-sr-outline {
            width: 100%;
            border: 1.5px solid var(--sr-blue);
            color: var(--sr-blue);
            background: #fff;
            font-weight: 600;
            border-radius: var(--sr-radius-sm);
            padding: .55rem;
            transition: all .18s;
        }

            .btn-sr-outline:hover {
                background: var(--sr-blue);
                color: #fff;
            }

        .sr-feature {
            background: #fff;
            border: 1px solid var(--sr-line);
            border-radius: var(--sr-radius);
            padding: 1.75rem 1.5rem;
            height: 100%;
            transition: transform .2s, box-shadow .2s;
        }

            .sr-feature:hover {
                transform: translateY(-4px);
                box-shadow: var(--sr-shadow);
            }

        .sr-feature-icon {
            width: 52px;
            height: 52px;
            border-radius: var(--sr-radius-sm);
            background: var(--sr-sky-soft);
            color: var(--sr-blue);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            margin-bottom: 1rem;
        }

        .sr-feature-title {
            font-size: 1.08rem;
            font-weight: 700;
            color: var(--sr-navy);
            margin-bottom: .5rem;
        }

        .sr-feature-text {
            font-size: .92rem;
            color: var(--sr-muted);
            margin: 0;
            line-height: 1.55;
        }

        .sr-campaign {
            background: #fff;
            border: 1px solid var(--sr-line);
            border-radius: var(--sr-radius);
            overflow: hidden;
            height: 100%;
            display: flex;
            box-shadow: var(--sr-shadow-sm);
            transition: transform .2s, box-shadow .2s;
        }

            .sr-campaign:hover {
                transform: translateY(-4px);
                box-shadow: var(--sr-shadow);
            }

        .sr-campaign-media {
            flex: 0 0 40%;
            min-height: 150px;
            background-size: cover;
            background-position: center;
            position: relative;
        }

        .sr-campaign-badge {
            position: absolute;
            top: .7rem;
            left: .7rem;
            background: var(--sr-blue);
            color: #fff;
            font-weight: 800;
            font-size: .85rem;
            padding: .3rem .6rem;
            border-radius: 6px;
        }

        .sr-badge-amber {
            background: var(--sr-amber);
        }

        .sr-badge-teal {
            background: var(--sr-teal);
        }

        .sr-campaign-body {
            padding: 1.1rem 1.2rem;
            flex: 1;
        }

        .sr-campaign-date {
            font-size: .78rem;
            color: var(--sr-sky);
            font-weight: 600;
            display: block;
            margin-bottom: .4rem;
        }

        .sr-campaign-title {
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--sr-navy);
            margin-bottom: .4rem;
        }

        .sr-campaign-text {
            font-size: .88rem;
            color: var(--sr-muted);
            margin-bottom: .7rem;
            line-height: 1.5;
        }

        .sr-campaign-link {
            font-weight: 600;
            color: var(--sr-blue);
            font-size: .9rem;
        }

            .sr-campaign-link i {
                transition: transform .2s;
            }

            .sr-campaign-link:hover i {
                transform: translateX(4px);
            }

        .sr-flex-title {
            font-size: 2rem;
            font-weight: 800;
            color: var(--sr-navy);
            letter-spacing: -.5px;
            margin-bottom: 1rem;
        }

        .sr-flex-text {
            color: var(--sr-muted);
            font-size: 1.05rem;
            margin-bottom: 1.25rem;
            line-height: 1.6;
        }

        .sr-flex-list {
            list-style: none;
            padding: 0;
            margin: 0 0 1.5rem;
        }

            .sr-flex-list li {
                display: flex;
                align-items: center;
                gap: .6rem;
                padding: .35rem 0;
                font-weight: 500;
                color: var(--sr-ink);
            }

            .sr-flex-list i {
                color: var(--sr-teal);
                font-size: 1.1rem;
            }

        .sr-flex-media {
            border-radius: var(--sr-radius);
            overflow: hidden;
            box-shadow: var(--sr-shadow);
        }

            .sr-flex-media img {
                width: 100%;
                height: 380px;
                object-fit: cover;
                display: block;
            }

        .sr-app {
            background: linear-gradient( 120deg, var(--sr-navy) 0%, var(--sr-blue-dark) 100% );
            color: #fff;
            padding: 4rem 0;
            overflow: hidden;
        }

        .sr-app-title {
            font-size: 2rem;
            font-weight: 800;
            margin-bottom: .75rem;
        }

        .sr-app-text {
            color: rgba(255, 255, 255, .85);
            font-size: 1.08rem;
            margin-bottom: 1.5rem;
            max-width: 480px;
        }

        .sr-store-buttons {
            display: flex;
            gap: .8rem;
            flex-wrap: wrap;
        }

        .sr-store-btn {
            display: inline-flex;
            align-items: center;
            gap: .6rem;
            background: rgba(255, 255, 255, .1);
            border: 1px solid rgba(255, 255, 255, .25);
            color: #fff;
            padding: .6rem 1.1rem;
            border-radius: var(--sr-radius-sm);
            transition: background-color .2s;
        }

            .sr-store-btn:hover {
                background: rgba(255, 255, 255, .2);
                color: #fff;
            }

            .sr-store-btn i {
                font-size: 1.6rem;
            }

            .sr-store-btn span {
                display: flex;
                flex-direction: column;
                line-height: 1.1;
            }

            .sr-store-btn small {
                font-size: .68rem;
                opacity: .8;
            }

            .sr-store-btn strong {
                font-size: .98rem;
            }

        .sr-app-visual {
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

            .sr-app-visual > i {
                font-size: 9rem;
                color: #fff;
                position: relative;
                z-index: 2;
            }

        .sr-app-glow {
            position: absolute;
            width: 220px;
            height: 220px;
            border-radius: 50%;
            background: radial-gradient( circle, rgba(74,163,232,.55), transparent 70% );
            filter: blur(10px);
        }

        .sr-newsletter {
            padding: 0 0 4.5rem;
            background: var(--sr-bg);
            margin-top: 4.5rem;
        }

        .sr-newsletter-card {
            background: var(--sr-sky-soft);
            border: 1px solid rgba(22, 104, 201, .15);
            border-radius: var(--sr-radius);
            padding: 2.25rem 2rem;
        }

        .sr-newsletter-title {
            font-size: 1.7rem;
            font-weight: 800;
            color: var(--sr-navy);
            margin-bottom: .3rem;
        }

        .sr-newsletter-text {
            color: var(--sr-muted);
            margin: 0;
        }

        .sr-newsletter-fields {
            display: flex;
            gap: .6rem;
        }

            .sr-newsletter-fields .sr-input {
                padding-left: 1rem;
            }

            .sr-newsletter-fields .btn {
                white-space: nowrap;
                height: 52px;
            }

        .sr-footer {
            background: var(--sr-navy);
            color: rgba(255, 255, 255, .78);
            padding: 3.5rem 0 1.75rem;
        }

        .sr-footer-about {
            font-size: .9rem;
            line-height: 1.6;
            color: rgba(255, 255, 255, .7);
            max-width: 340px;
        }

        .sr-social {
            display: flex;
            gap: .6rem;
            margin-top: 1.2rem;
        }

            .sr-social a {
                width: 38px;
                height: 38px;
                border-radius: 8px;
                background: rgba(255, 255, 255, .1);
                color: #fff;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 1.05rem;
                transition: background-color .2s;
            }

                .sr-social a:hover {
                    background: var(--sr-blue);
                }

        .sr-footer-head {
            background: none;
            border: none;
            color: #fff;
            font-weight: 700;
            font-size: 1rem;
            padding: 0;
            margin-bottom: 1rem;
            width: 100%;
            text-align: left;
            display: flex;
            align-items: center;
            justify-content: space-between;
            pointer-events: none;
        }

        .sr-foot-chev {
            display: none;
            transition: transform .2s;
        }

        .sr-footer-links {
            list-style: none;
            padding: 0;
            margin: 0;
        }

            .sr-footer-links.collapse:not(.show) {
                display: block;
            }

            .sr-footer-links li {
                margin-bottom: .55rem;
            }

            .sr-footer-links a {
                color: rgba(255, 255, 255, .72);
                font-size: .9rem;
                transition: color .2s;
            }

                .sr-footer-links a:hover {
                    color: var(--sr-sky);
                }

        .sr-footer-divider {
            border-color: rgba(255, 255, 255, .12);
            margin: 2.5rem 0 1.25rem;
        }

        .sr-footer-bottom {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .sr-copyright {
            font-size: .85rem;
            color: rgba(255, 255, 255, .6);
        }

        .sr-payments {
            display: flex;
            gap: .7rem;
            font-size: 1.5rem;
            color: rgba(255, 255, 255, .55);
        }

        #srToast {
            background: var(--sr-navy);
            color: #fff;
        }

            #srToast.sr-toast-success {
                background: var(--sr-teal);
            }

            #srToast.sr-toast-error {
                background: #d33a3a;
            }

        @@media (max-width: 991.98px) {
            #heroSlider,
            .carousel-inner {
                height: 480px;
            }

            .sr-slide-title {
                font-size: 2.3rem;
            }

            .sr-search-panel {
                margin-top: -60px;
            }

            .navbar-collapse {
                background: #fff;
                margin-top: .75rem;
                border-radius: var(--sr-radius);
                padding: 1rem;
                box-shadow: var(--sr-shadow);
            }

            .sr-navbar .nav-link,
            .sr-navbar .nav-link.active {
                color: var(--sr-ink);
            }

            .sr-mini-select {
                border-color: var(--sr-line);
                background-color: #fff;
                color: var(--sr-ink);
            }
        }

        @@media (max-width: 767.98px) {
            #heroSlider,
            .carousel-inner {
                height: 420px;
            }

            .sr-slide-content {
                padding-bottom: 4.5rem;
                text-align: left;
            }

            .sr-slide-title {
                font-size: 1.7rem;
            }

            .sr-slide-desc {
                font-size: 1rem;
            }

            .sr-search-panel {
                margin-top: 1.25rem;
                padding: 1.25rem;
            }

            .sr-section {
                padding: 3rem 0;
            }

            .sr-section-title,
            .sr-flex-title,
            .sr-app-title {
                font-size: 1.6rem;
            }

            .sr-campaign {
                flex-direction: column;
            }

            .sr-campaign-media {
                flex: none;
                width: 100%;
                height: 150px;
            }

            .sr-flex-media img {
                height: 260px;
            }

            .sr-newsletter-fields {
                flex-direction: column;
            }

                .sr-newsletter-fields .btn {
                    width: 100%;
                }

            .sr-footer-head {
                pointer-events: auto;
            }

            .sr-foot-chev {
                display: inline-block;
            }

            .sr-footer-links.collapse:not(.show) {
                display: none;
            }

            .sr-footer-col {
                border-bottom: 1px solid rgba(255,255,255,.12);
                padding-bottom: .9rem;
                margin-bottom: .3rem;
            }

            .sr-footer-head[aria-expanded="true"] .sr-foot-chev {
                transform: rotate(180deg);
            }

            .sr-footer-bottom {
                flex-direction: column;
                align-items: flex-start;
            }
        }

        @@media (max-width: 575.98px) {
            .sr-app-visual > i {
                font-size: 6.5rem;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            * {
                animation-duration: .001ms !important;
                transition-duration: .001ms !important;
            }
        }
    </style>

</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg fixed-top sr-navbar" id="mainNavbar">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" href="/Flight/Index">
                    <span class="sr-logo-mark" aria-hidden="true">
                        <i class="bi bi-send-fill"></i>
                    </span>

                    <span class="sr-logo-text">
                        Sky<span class="sr-logo-accent">Route</span>
                    </span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNav"
                        aria-controls="mainNav"
                        aria-expanded="false"
                        aria-label="Menyunu aç/bağla">
                    <i class="bi bi-list"></i>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav mx-lg-auto mb-3 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link active" href="#aramaPaneli">
                                Uçuş axtar
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="#kampanyalar">
                                Kampaniyalar
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="#populerRotalar">
                                Populyar marşrutlar
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="#esnekSeyahat">
                                Səyahət bələdçisi
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="#footer">
                                Yardım
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex flex-column flex-lg-row align-items-lg-center gap-2">
                        <select class="form-select form-select-sm sr-mini-select"
                                id="navLang"
                                aria-label="Dil seçimi">
                            <option value="az" selected>AZ</option>
                            <option value="en">EN</option>
                            <option value="ru">RU</option>
                        </select>

                        <a href="#" class="btn btn-sr-login btn-sm">
                            <i class="bi bi-person-circle me-1"></i>
                            Daxil ol
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <section class="sr-hero">

        <div id="heroSlider"
             class="carousel slide carousel-fade"
             data-bs-ride="carousel"
             data-bs-interval="6000">

            <div class="carousel-indicators sr-indicators">
                <button type="button"
                        data-bs-target="#heroSlider"
                        data-bs-slide-to="0"
                        class="active"
                        aria-current="true"
                        aria-label="Slayd 1">
                </button>

                <button type="button"
                        data-bs-target="#heroSlider"
                        data-bs-slide-to="1"
                        aria-label="Slayd 2">
                </button>

                <button type="button"
                        data-bs-target="#heroSlider"
                        data-bs-slide-to="2"
                        aria-label="Slayd 3">
                </button>
            </div>

            <div class="carousel-inner h-100">

                <div class="carousel-item active h-100">
                    <div class="sr-slide"
                         style="background-image:url('https://images.unsplash.com/photo-1436491865332-7a61a109cc05?auto=format&fit=crop&w=1920&q=80');">

                        <div class="sr-slide-overlay"></div>

                        <div class="container sr-slide-content">
                            <p class="sr-eyebrow">
                                SkyRoute ilə kəşf et
                            </p>

                            <h1 class="sr-slide-title">
                                Yeni marşrutları kəşf etməyə hazırsan?
                            </h1>

                            <p class="sr-slide-desc">
                                Yüzlərlə aviaşirkətin uçuşlarını müqayisə et,
                                sənin üçün ən uyğun səyahəti asanlıqla tap.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="carousel-item h-100">
                    <div class="sr-slide"
                         style="background-image:url('https://images.unsplash.com/photo-1503152394-c571994fd383?auto=format&fit=crop&w=1920&q=80');">

                        <div class="sr-slide-overlay"></div>

                        <div class="container sr-slide-content">
                            <p class="sr-eyebrow">
                                Avropa fürsətləri
                            </p>

                            <h1 class="sr-slide-title">
                                Avropa uçuşlarında sərfəli qiymətlər
                            </h1>

                            <p class="sr-slide-desc">
                                Amsterdam, Milan, Paris və Roma uçuşlarını
                                bir ekranda müqayisə et.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="carousel-item h-100">
                    <div class="sr-slide"
                         style="background-image:url('https://images.unsplash.com/photo-1488085061387-422e29b40080?auto=format&fit=crop&w=1920&q=80');">

                        <div class="sr-slide-overlay"></div>

                        <div class="container sr-slide-content">
                            <p class="sr-eyebrow">
                                Planlamanı asanlaşdır
                            </p>

                            <h1 class="sr-slide-title">
                                Xəyalındakı səyahət bir neçə addım uzaqdadır
                            </h1>

                            <p class="sr-slide-desc">
                                Çevik tarix seçimləri və inkişaf etmiş filtrlərlə
                                səyahətini asanlıqla planla.
                            </p>
                        </div>
                    </div>
                </div>

            </div>

            <button class="carousel-control-prev sr-control"
                    type="button"
                    data-bs-target="#heroSlider"
                    data-bs-slide="prev">

                <span class="sr-control-icon">
                    <i class="bi bi-chevron-left"></i>
                </span>

                <span class="visually-hidden">
                    Əvvəlki
                </span>
            </button>

            <button class="carousel-control-next sr-control"
                    type="button"
                    data-bs-target="#heroSlider"
                    data-bs-slide="next">

                <span class="sr-control-icon">
                    <i class="bi bi-chevron-right"></i>
                </span>

                <span class="visually-hidden">
                    Növbəti
                </span>
            </button>
        </div>

        <div class="container">

            <div class="sr-search-panel" id="aramaPaneli">

                <div class="sr-trip-types"
                     role="tablist"
                     aria-label="Səyahət növü">

                    <input type="radio"
                           class="btn-check"
                           name="tripType"
                           id="tripRound"
                           value="round"
                           checked>

                    <label class="sr-trip-btn" for="tripRound">
                        <i class="bi bi-arrow-left-right me-1"></i>
                        Gediş-dönüş
                    </label>

                    <input type="radio"
                           class="btn-check"
                           name="tripType"
                           id="tripOne"
                           value="oneway">

                    <label class="sr-trip-btn" for="tripOne">
                        <i class="bi bi-arrow-right me-1"></i>
                        Tək istiqamət
                    </label>

                    <input type="radio"
                           class="btn-check"
                           name="tripType"
                           id="tripMulti"
                           value="multi">

                    <label class="sr-trip-btn" for="tripMulti">
                        <i class="bi bi-diagram-3 me-1"></i>
                        Çoxlu uçuş
                    </label>
                </div>

                <form id="flightSearchForm" novalidate>

                    <div class="row g-3 align-items-end">

                        <div class="col-12 col-lg-5">

                            <div class="row g-2 sr-swap-row position-relative">

                                <div class="col-6 sr-field-wrap">

                                    <label class="sr-label" for="fromInput">
                                        Gediş nöqtəsi
                                    </label>

                                    <div class="sr-input-icon">
                                        <i class="bi bi-airplane-engines"></i>

                                        <input type="text"
                                               class="form-control sr-input"
                                               id="fromInput"
                                               placeholder="Şəhər adını yazın (məs. Bakı)"
                                               autocomplete="off">
                                    </div>

                                    <div class="sr-error" id="fromError"></div>
                                </div>

                                <div class="col-6 sr-field-wrap">

                                    <label class="sr-label" for="toInput">
                                        Təyinat nöqtəsi
                                    </label>

                                    <div class="sr-input-icon">
                                        <i class="bi bi-geo-alt"></i>

                                        <input type="text"
                                               class="form-control sr-input"
                                               id="toInput"
                                               placeholder="Şəhər adını yazın (məs. Amsterdam)"
                                               autocomplete="off">
                                    </div>

                                    <div class="sr-error" id="toError"></div>
                                </div>

                                <button type="button"
                                        class="sr-swap-btn"
                                        id="swapBtn"
                                        aria-label="Gediş və təyinatı dəyişdir"
                                        title="Yerləri dəyişdir">

                                    <i class="bi bi-arrow-left-right"></i>
                                </button>

                            </div>
                        </div>

                        <div class="col-6 col-lg-2 sr-field-wrap">

                            <label class="sr-label" for="departDate">
                                Gediş tarixi
                            </label>

                            <div class="sr-input-icon">
                                <i class="bi bi-calendar-event"></i>

                                <input type="date"
                                       class="form-control sr-input"
                                       id="departDate">
                            </div>

                            <div class="sr-error" id="departError"></div>
                        </div>

                        <div class="col-6 col-lg-2 sr-field-wrap"
                             id="returnWrap">

                            <label class="sr-label" for="returnDate">
                                Dönüş tarixi
                            </label>

                            <div class="sr-input-icon">
                                <i class="bi bi-calendar-event"></i>

                                <input type="date"
                                       class="form-control sr-input"
                                       id="returnDate">
                            </div>

                            <div class="sr-error" id="returnError"></div>
                        </div>

                        <div class="col-12 col-lg-3 sr-field-wrap">

                            <label class="sr-label" for="passengerToggle">
                                Sərnişin və kabin
                            </label>

                            <div class="dropdown">

                                <button class="form-control sr-input sr-dropdown-toggle text-start"
                                        type="button"
                                        id="passengerToggle"
                                        data-bs-toggle="dropdown"
                                        data-bs-auto-close="outside"
                                        aria-expanded="false">

                                    <i class="bi bi-people me-1"></i>

                                    <span id="passengerSummary">
                                        1 sərnişin
                                    </span>

                                    <span class="text-muted">
                                        ·
                                        <span id="cabinSummary">
                                            Ekonom
                                        </span>
                                    </span>
                                </button>

                                <div class="dropdown-menu sr-passenger-menu p-3">

                                    <div class="sr-pax-row">

                                        <div>
                                            <div class="sr-pax-title">
                                                Böyük
                                            </div>

                                            <div class="sr-pax-sub">
                                                12 yaş və yuxarı
                                            </div>
                                        </div>

                                        <div class="sr-stepper">

                                            <button type="button"
                                                    class="sr-step-btn"
                                                    data-type="adult"
                                                    data-action="dec"
                                                    aria-label="Böyük sayını azalt">
                                                −
                                            </button>

                                            <span class="sr-step-value"
                                                  id="adultCount">
                                                1
                                            </span>

                                            <button type="button"
                                                    class="sr-step-btn"
                                                    data-type="adult"
                                                    data-action="inc"
                                                    aria-label="Böyük sayını artır">
                                                +
                                            </button>

                                        </div>
                                    </div>

                                    <div class="sr-pax-row">

                                        <div>
                                            <div class="sr-pax-title">
                                                Uşaq
                                            </div>

                                            <div class="sr-pax-sub">
                                                2–11 yaş
                                            </div>
                                        </div>

                                        <div class="sr-stepper">

                                            <button type="button"
                                                    class="sr-step-btn"
                                                    data-type="child"
                                                    data-action="dec"
                                                    aria-label="Uşaq sayını azalt">
                                                −
                                            </button>

                                            <span class="sr-step-value"
                                                  id="childCount">
                                                0
                                            </span>

                                            <button type="button"
                                                    class="sr-step-btn"
                                                    data-type="child"
                                                    data-action="inc"
                                                    aria-label="Uşaq sayını artır">
                                                +
                                            </button>

                                        </div>
                                    </div>

                                    <div class="sr-pax-row">

                                        <div>
                                            <div class="sr-pax-title">
                                                Körpə
                                            </div>

                                            <div class="sr-pax-sub">
                                                0–2 yaş
                                            </div>
                                        </div>

                                        <div class="sr-stepper">

                                            <button type="button"
                                                    class="sr-step-btn"
                                                    data-type="infant"
                                                    data-action="dec"
                                                    aria-label="Körpə sayını azalt">
                                                −
                                            </button>

                                            <span class="sr-step-value"
                                                  id="infantCount">
                                                0
                                            </span>

                                            <button type="button"
                                                    class="sr-step-btn"
                                                    data-type="infant"
                                                    data-action="inc"
                                                    aria-label="Körpə sayını artır">
                                                +
                                            </button>

                                        </div>
                                    </div>

                                    <div class="sr-pax-note"
                                         id="paxNote">
                                    </div>

                                    <hr class="my-2">

                                    <label class="sr-label"
                                           for="cabinClass">
                                        Kabin sinfi
                                    </label>

                                    <select class="form-select sr-input"
                                            id="cabinClass">

                                        <option value="economy" selected>
                                            Ekonom
                                        </option>

                                        <option value="premium">
                                            Premium ekonom
                                        </option>

                                        <option value="business">
                                            Biznes
                                        </option>

                                        <option value="first">
                                            Birinci sinif
                                        </option>
                                    </select>

                                    <button type="button"
                                            class="btn btn-sr-primary w-100 mt-3"
                                            id="paxDone">
                                        Tamam
                                    </button>

                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row g-3 align-items-end mt-1">

                        <div class="col-12 col-lg-7">
                        </div>

                        <div class="col-12 col-lg-5">

                            <button type="submit"
                                    class="btn btn-sr-search w-100"
                                    id="searchBtn">

                                <span class="sr-btn-label">
                                    <i class="bi bi-search me-2"></i>
                                    Uçuş axtar
                                </span>

                                <span class="sr-btn-loading d-none">
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    Uyğun uçuşlar axtarılır...
                                </span>

                            </button>
                        </div>

                    </div>

                </form>
            </div>
        </div>
    </section>

    <section class="sr-section" id="populerRotalar">

        <div class="container">

            <div class="sr-section-head">

                <p class="sr-section-eyebrow">
                    Tez-tez seçilən
                </p>

                <h2 class="sr-section-title">
                    Populyar uçuş marşrutları
                </h2>

                <p class="sr-section-sub">
                    Səyahətçilərin ən çox axtardığı marşrutlarda
                    başlanğıc qiymətlərini kəşf et.
                </p>

            </div>

            <div class="row g-4 sr-routes-row"></div>

        </div>
    </section>

    <section class="sr-section sr-section-alt" id="avantajlar">

        <div class="container">

            <div class="sr-section-head">

                <p class="sr-section-eyebrow">
                    Fərqimiz
                </p>

                <h2 class="sr-section-title">
                    Niyə bizi seçməlisiniz?
                </h2>

            </div>

            <div class="row g-4">

                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="sr-feature">

                        <span class="sr-feature-icon">
                            <i class="bi bi-bar-chart-line"></i>
                        </span>

                        <h3 class="sr-feature-title">
                            Yüzlərlə aviaşirkəti müqayisə et
                        </h3>

                        <p class="sr-feature-text">
                            Tək axtarışla onlarla aviaşirkəti yan-yana gətir,
                            ən uyğun seçimi asanlıqla gör.
                        </p>

                    </div>
                </div>

                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="sr-feature">

                        <span class="sr-feature-icon">
                            <i class="bi bi-shield-check"></i>
                        </span>

                        <h3 class="sr-feature-title">
                            Təhlükəsiz və sürətli axtarış
                        </h3>

                        <p class="sr-feature-text">
                            Məlumatların qorunur, axtarış nəticələrin
                            saniyələr ərzində qarşına çıxır.
                        </p>

                    </div>
                </div>

                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="sr-feature">

                        <span class="sr-feature-icon">
                            <i class="bi bi-tag"></i>
                        </span>

                        <h3 class="sr-feature-title">
                            Şəffaf qiymətləndirmə
                        </h3>

                        <p class="sr-feature-text">
                            Gizli ödəniş yoxdur. Gördüyün qiymət,
                            ödəyəcəyin qiymətdir.
                        </p>

                    </div>
                </div>

                <div class="col-12 col-sm-6 col-lg-3">
